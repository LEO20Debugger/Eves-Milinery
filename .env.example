# Enquiry form delivery (https://resend.com).
# Leave unset in development: the Server Action logs the enquiry to the console
# and reports success, so the whole form is testable without an account.
RESEND_API_KEY=

# Verified sending domain on Resend, and the inbox enquiries land in.
ENQUIRY_FROM=enquiries@evesmillinery.com
ENQUIRY_TO=atelier@evesmillinery.com
